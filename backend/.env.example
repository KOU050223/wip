# PostgreSQLの接続先（必須）
DATABASE_URL="postgres://wip:wip_password@localhost:5432/wip?sslmode=disable"
UPSTASH_REDIS_URL="rediss://default:password@region-name.upstash.io:6379"

# HTTPサーバーの待ち受けポート（未設定時は8080）
PORT=8080

# CORSで許可するオリジンをカンマ区切りで指定（未設定時は下記と同じ値がデフォルト）
# 本番デプロイ時はフロントエンドのオリジンを指定する。
#   https://wip-frontend.uozumi05.workers.dev  (workers.dev)
#   https://wip-frontend.uomi.dev              (カスタムドメイン)
CORS_ALLOW_ORIGINS="http://localhost:3000,http://localhost:5173"

# ゲストCookieの署名鍵（本番では `openssl rand -base64 32` などで生成したランダム値に置き換える）
GUEST_SESSION_SECRET=
