{
  "name": "wip-backend-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "build:go": "go run github.com/syumai/workers-go/cmd/workers-assets-gen -mode=go -o ./build && GOOS=js GOARCH=wasm go build -ldflags=\"-s -w\" -o ./build/app.wasm ./cmd/server",
    "build": "npm run build:go"
  },
  "dependencies": {
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.126.0"
  }
}
