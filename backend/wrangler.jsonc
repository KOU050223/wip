{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wip-backend",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],

  // Go を js/wasm にビルドし、worker/index.ts が読み込む build/worker.mjs を生成する。
  "build": {
    "command": "npm run build:go",
  },

  "ai": {
    "binding": "AI",
  },

  // API はフロントエンドから呼ばれるだけでユーザーが直接開くものではないため、
  // カスタムドメインは設定せず workers.dev のURLで配信する。
  "workers_dev": true,
  "preview_urls": true,

  // Go 側へ渡す非機密の設定値。
  // DATABASE_URL は機密なので vars ではなく `wrangler secret put` で登録する。
  "vars": {
    "CORS_ALLOW_ORIGINS": "https://wip-frontend.uomi.dev,https://wip-frontend.uozumi05.workers.dev",
  },

  // Containers から Workers へ移行したため、コンテナ用の Durable Object を破棄する。
  // v1 は適用済みのため、履歴として残したうえで v2 で削除する。
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BackendContainer"],
    },
    {
      "tag": "v2",
      "deleted_classes": ["BackendContainer"],
    },
  ],

  "observability": {
    "enabled": true,
  },
}
