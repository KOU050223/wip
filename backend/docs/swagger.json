{
    "swagger": "2.0",
    "info": {
        "description": "Score management API.",
        "title": "Score API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/api/rankings": {
            "get": {
                "description": "Returns scores ordered by score (desc), then clear time (asc), then created time (asc).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "scores"
                ],
                "summary": "Get rankings",
                "operationId": "getRankings",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Max number of entries to return (1-100, default 10)",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/httpapi.RankingsResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/scores": {
            "post": {
                "description": "Saves a player's score, max combo, and clear time.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "scores"
                ],
                "summary": "Save score",
                "operationId": "saveScore",
                "parameters": [
                    {
                        "description": "Score payload",
                        "name": "score",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/usecase.CreateScoreInput"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/domain.Score"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "domain.Score": {
            "type": "object",
            "properties": {
                "clear_time": {
                    "type": "integer"
                },
                "created_at": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "max_combo": {
                    "type": "integer"
                },
                "player_name": {
                    "type": "string"
                },
                "score": {
                    "type": "integer"
                }
            }
        },
        "httpapi.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                }
            }
        },
        "httpapi.RankingsResponse": {
            "type": "object",
            "properties": {
                "rankings": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/domain.Score"
                    }
                }
            }
        },
        "usecase.CreateScoreInput": {
            "type": "object",
            "properties": {
                "clear_time": {
                    "type": "integer"
                },
                "max_combo": {
                    "type": "integer"
                },
                "player_name": {
                    "type": "string"
                },
                "score": {
                    "type": "integer"
                }
            }
        }
    }
}